# Copy this file to .env and fill in what you use. Never commit .env.
# Argonauta reads .env from the repository root. Every key is optional:
# without ANTHROPIC_API_KEY the app runs in the degraded "manual" mode
# (see README, "Degraded mode").
#
# Keys marked SHELL ONLY are ignored when they appear in .env, because a
# cloned repository must not be able to choose what gets executed. Export
# them in your shell instead, or use `argonauta config set-test-command`.

# --- Model access (optional) -------------------------------------------------
# Anthropic API key. If unset, no network request is ever made.
ANTHROPIC_API_KEY=

# Model to ask for diffs. Default: claude-opus-5-5
ARGONAUTA_MODEL=claude-opus-5-5

# Reasoning effort: low | medium | high | xhigh | max. Default: medium
ARGONAUTA_EFFORT=medium

# Server-side refusal fallbacks ("default" or "off"). Default: default
ARGONAUTA_FALLBACKS=default

# --- Provider selection (SHELL ONLY) -----------------------------------------
# auto | anthropic | local | claude-cli | manual | scripted
#   auto       -> anthropic when a key is present, else local when
#                 ARGONAUTA_LOCAL_MODEL is set, otherwise manual
#   local      -> a model on your machine through an OpenAI-compatible API
#   claude-cli -> the installed Claude Code CLI (`claude -p`), covered by
#                 your Claude subscription; no API key involved
#   manual    -> write a prompt bundle; you paste the model's diff back in
#   scripted  -> TEST ONLY: returns the diff in ARGONAUTA_SCRIPTED_DIFF
ARGONAUTA_PROVIDER=auto
ARGONAUTA_SCRIPTED_DIFF=
# SHELL ONLY: path to the `claude` binary when it is not on PATH.
ARGONAUTA_CLAUDE_BIN=

# --- Local model (Ollama, LM Studio, llama.cpp server, vLLM) -----------------
# Model name as the server knows it, e.g. qwen2.5-coder:7b. Setting it (with
# no Anthropic key) makes `auto` pick the local provider.
ARGONAUTA_LOCAL_MODEL=
# Optional bearer token for servers that require one.
ARGONAUTA_LOCAL_API_KEY=
# SHELL ONLY: base URL of the OpenAI-compatible API. Default is Ollama's.
# Must be a loopback address unless ARGONAUTA_LOCAL_ALLOW_REMOTE=1 (shell only),
# because your code is sent there.
ARGONAUTA_LOCAL_URL=http://127.0.0.1:11434/v1
ARGONAUTA_LOCAL_ALLOW_REMOTE=

# --- Context limits (keeps requests small and predictable) -------------------
ARGONAUTA_MAX_CONTEXT_FILES=8
ARGONAUTA_MAX_CONTEXT_BYTES=60000

# --- Test runner -------------------------------------------------------------
# SHELL ONLY: overrides the per-repository test command stored by `argonauta init`.
ARGONAUTA_TEST_COMMAND=
# Seconds before a test run is killed. Default: 600
ARGONAUTA_TEST_TIMEOUT=600

# --- Web UI (SHELL ONLY) -------------------------------------------------------
# Where the workspaces registry lives. Default: ~/.config/argonauta
ARGONAUTA_CONFIG_DIR=
